# Vercel menyuntikkan env npm_config_cache_dir yang tidak dikenal npm 11,
# sehingga setiap build mencetak "npm warn Unknown env config \"cache-dir\"".
# Itu warning kosmetik dari platform (bukan dari proyek ini), jadi output npm
# dibatasi ke level error. Error asli tetap muncul; yang disembunyikan hanya warn.
loglevel=error
